# Private provider credential. Set this in Vercel Environment Variables too.
PLANTNET_API_KEY=
# Public per-site client identifier, separate from the private provider key.
PETALCORE_ID_API_KEY=petalcore-id-public-client
# Optional: full shared backend URL, e.g. https://your-api.example/api/v1
PUBLIC_API_BASE_URL=/api/v1
# Optional: comma-separated frontend origins when hosting the API separately.
ALLOWED_ORIGINS=
